// 1. Generator: Specifies that Prisma should generate a JavaScript client
generator client {
  provider = "prisma-client-js"
}

// 2. Datasource: Defines your connection to the PostgreSQL database
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Pulls the connection string from your .env file
}

// 3. Model: Defines your "notes" table structure
model Note {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  title     String?
  content   String?

  // The ID of the user from Google/Firebase Auth who owns the note
  userId    String   @map("user_id")
}
